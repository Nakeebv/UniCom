# ── UniCom optional integrations ────────────────────────────────────────────
# Copy to `.env` and fill in. EVERY feature below is env-gated: the app stays
# fully functional with demo paths when values are missing. Never commit .env.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Cloudflare R2 (voice notes, avatars; private bucket) ────────────────────
# Dashboard → R2 → Create bucket → R2 API tokens (Object Read & Write)
R2_ACCOUNT_ID=
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=unicom-media

# ── Cloudflare Workers AI (Whisper STT + MeloTTS) ───────────────────────────
# Dashboard → Workers AI → API tokens (permission: "Workers AI Run")
# Models (defaults; override if you prefer):
# CLOUDFLARE_WHISPER_MODEL=@cf/openai/whisper-large-v3-turbo
# CLOUDFLARE_TTS_MODEL=@cf/myshell-ai/melotts
CLOUDFLARE_AI_API_TOKEN=

# ── Groq (high-quality LLM translation + optional STT alternative) ─────────
# console.groq.com → API keys (free tier)
# Models (defaults): STT whisper-large-v3-turbo · MT llama-3.3-70b-versatile
GROQ_API_KEY=

# ── Feature overrides (defaults shown) ───────────────────────────────────────
# STT_PROVIDER=auto        # auto | cloudflare | groq | off
# TTS_PROVIDER=auto        # auto | cloudflare | off
# MT via groq activates whenever GROQ_API_KEY is present.
# STORAGE=auto             # auto (=r2 when configured) | db

# ── Translation provider override (legacy demo knob) ────────────────────────
# TRANSLATION_PROVIDER=auto # auto | mymemory | gtx | offline
